PORT=4000
CLIENT_URL=http://127.0.0.1:5173
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster-name.xxxxx.mongodb.net/shopnova?retryWrites=true&w=majority

# Product image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional email for verification/reset codes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SHOPNOVA <no-reply@shopnova.ng>

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_SEED_ACCOUNTS=false

# Only needed when running `npm run create:admin`; remove from Render afterward.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_unique_12_plus_character_password
